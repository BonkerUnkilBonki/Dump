# ------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Where the dump goes. Public channel -> @handle, private -> -100... id.
TELEGRAM_CHANNEL_ID=@BonkiDump

# ------------------------------------------------------------------
# GitHub
# ------------------------------------------------------------------
# The account whose PUBLIC repos are swept for release files.
GITHUB_USER=BonkerUnkilBonki

# STRONGLY recommended. Without it GitHub allows only 60 requests/hour
# (a full sweep of several repos will blow through that). A fine-grained
# token with "Public Repositories (read-only)" is enough.
GITHUB_TOKEN=

# ------------------------------------------------------------------
# How to run
# ------------------------------------------------------------------
# true  = do one sweep and exit (use this for the initial backfill)
# false = sweep, wait POLL_INTERVAL, sweep again, forever
ONCE=false

# true  = run as a WEB SERVICE: bind $PORT, serve a health page, and run
#         the sweep loop in the background. Use this on Render etc.
WEB=false

# Seconds between sweeps (default 30 min)
POLL_INTERVAL=1800

# Optional key protecting the /sweep trigger endpoint. If set, a caller must
# pass ?key=... (or an X-Sweep-Key header). Leave blank to disable the check.
SWEEP_KEY=

# ------------------------------------------------------------------
# What to send
# ------------------------------------------------------------------
# Forward pre-releases too (default true)
INCLUDE_PRERELEASES=true

# Only send assets whose filename matches this regex. Blank = all files.
# e.g. ASSET_FILTER=\.apk$  to send only APKs
ASSET_FILTER=

# Max files per album. Telegram allows 2..10; bigger releases are split.
MAX_GROUP=10

# Put the release changelog in the album caption.
SEND_CHANGELOG=true

# Where the bot remembers what it has already sent.
STATE_FILE=dump_state.json
